amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

// The remedy for the collision, expressed with the mechanism hk already documents.
//
// Identical to hk_script_spawned_git.pkl — same 48 steps, same generator script, same random
// delays — except each git-invoking step sits in its OWN Group. Per hk's docs a group waits for
// previous steps/groups and blocks others from starting until it finishes, so the writers are
// serialised and cannot contend for .git/index.lock.
//
// It works, and the cost is the point: one group per writer, hand-written, and total
// serialisation rather than just mutual exclusion of the git call. Nothing in hk's output tells
// an author this is the fix when the collision happens.
hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    stage = true
    steps {
      ["writer0"] = new Group {
        steps = new Mapping<String, Step> {
          ["regenerate0"] = new Step {
            glob = "index_trigger0.txt"
            fix = "bash random_fast_sleep.sh && bash regenerate_and_stage.sh 0"
            stage = List()
          }
        }
      }
      ["writer1"] = new Group {
        steps = new Mapping<String, Step> {
          ["regenerate1"] = new Step {
            glob = "index_trigger1.txt"
            fix = "bash random_fast_sleep.sh && bash regenerate_and_stage.sh 1"
            stage = List()
          }
